{
  "name": "alexcuadra-frontend-staging",
  "main": "./src/staging-worker.js",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "run_worker_first": true },
  "services": [{ "binding": "CMS", "service": "alexcuadra-cms-staging" }],
  "vars": { "CONTACT_ENABLED": "false" }
}
