{
  "name": "alexcuadra.dev",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "build:production": "CLOUDFLARE_ENV=production npm run build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test tests/*.test.js",
    "check": "astro check",
    "deploy:staging": "npm run build && wrangler deploy",
    "test:smoke": "node scripts/smoke.mjs",
    "prebuild": "node scripts/build-info.mjs",
    "build:emdash-candidate": "astro build --config astro.emdash-public.config.mjs && node scripts/seal-emdash-public.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^14.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "dotenv": "^16.4.7",
    "graphql-request": "^7.1.2",
    "htmlparser2": "12.0.0",
    "motion": "14.6.0",
    "sanitize-html": "2.18.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.3",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
