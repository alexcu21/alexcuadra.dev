---
interface Props{
    count: number
}

const { count } = Astro.props

---
  
  <span class="count-badge">
    {count}
  </span>
<style>
  .count-badge { white-space: nowrap; border: 1px solid var(--gray-700); border-radius: 999px; padding: .2rem .6rem;
    color: var(--link-color); background: var(--accent-subtle-overlay); font-size: .75rem; }
</style>
