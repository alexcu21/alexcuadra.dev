---
import Icon from './Icon.astro';
interface Props { skills?: Record<string, string | null> | null; }
const allskills = Astro.props.skills ?? {};
const icons = ['web', 'trophy', 'strategy'] as const;
const skillsArray = [1, 2, 3].map((index, order) => ({
  name: allskills[`skillName${index}`], description: allskills[`skillDescription${index}`], icon: icons[order],
})).filter(skill => skill.name?.trim());

---

<ul class="skills">
  {skillsArray.map((skill, index) => <li data-motion="reveal" data-motion-delay={index * .06}>
    <div class="skill-top"><span class="skill-icon"><Icon icon={skill.icon} size="1.4rem" /></span><span class="skill-index" aria-hidden="true">// 0{index + 1}</span></div>
    <h3>{skill.name}</h3>
    {skill.description?.trim() && <p>{skill.description}</p>}
  </li>)}
</ul>

<style>
  .skills { display: grid; gap: 1rem; list-style: none; padding: 0; }
  .skills > li { min-width: 0; display: flex; flex-direction: column; gap: 1rem; padding: 1.5rem; border: 1px solid var(--gray-800); border-radius: 1rem; background: var(--gradient-subtle); overflow-wrap: anywhere; }
  .skill-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .skill-icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 1px solid var(--gray-800); border-radius: .65rem; color: var(--link-color); background: var(--accent-subtle-overlay); }
  .skill-index { color: var(--gray-400); font: .7rem/1.5 var(--font-mono); }
  h3 { font-size: 1.1rem; color: var(--gray-0); line-height: 1.4; }
  p { color: var(--gray-300); line-height: 1.7; font-size: .95rem; }
  @media (min-width: 50em) { .skills { grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); } }
</style>
