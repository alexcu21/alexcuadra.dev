---
import { getHomeInfo } from '../data/client';
import Icon from './Icon.astro';
interface Props { skills?: Record<string, string | null> | null; }
const allskills = Astro.props.skills ?? (await getHomeInfo('en'))[0].homePageFields.skills;

const skillsArray = Object.entries(allskills)
  .filter(([key]) => key.startsWith('skillName'))
  .map(([key, value]) => {
    const index = key.replace('skillName', '');
    return {
      name: value,
      description: allskills[`skillDescription${index}`],
    };
  });

---

<section class="box skills">
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="web" color="var(--accent-regular)" size="2.5rem" gradient />
		<h3>{skillsArray[0].name}</h3>
		<p>{skillsArray[0].description}</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="trophy" color="var(--accent-regular)" size="2.5rem" gradient />
		<h3>{skillsArray[1].name}</h3>
		<p>{skillsArray[1].description}</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="strategy" color="var(--accent-regular)" size="2.5rem" gradient />
		<h3>{skillsArray[2].name}</h3>
		<p>{skillsArray[2].description}</p>
	</div>
</section>

<style>
  .skills { display: grid; gap: 1rem; }
  .skills > div { padding: 1.5rem; border: 1px solid var(--gray-800); border-radius: 1rem; background: var(--gray-900); }
  h3 { font-size: 1.1rem; color: var(--gray-0); line-height: 1.4; }
  p { color: var(--gray-300); line-height: 1.7; font-size: .95rem; }
  @media (min-width: 50em) { .skills { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
