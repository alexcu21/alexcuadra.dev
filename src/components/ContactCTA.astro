---
import { getHomeInfo } from '../data/client';
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
import ContactForm from './ContactForm.astro';
import { env } from 'cloudflare:workers';

interface Props { locale?: 'en' | 'es'; }
const { locale = 'en' } = Astro.props;
const data = await getHomeInfo('en');
---

<aside>
	<h2>{locale === 'es' ? '¿Te interesa trabajar conmigo?' : 'Interested in working together?'}</h2>
	<CallToAction href={`mailto:${data[0].homePageFields.email}`}>
		{locale === 'es' ? 'Envíame un mensaje' : 'Send Me a Message'}
		<Icon icon="paper-plane-tilt" size="1.2em" />
	</CallToAction>
</aside>
{locale === 'en' && env.CONTACT_FORM_ENABLED === 'true' && env.TURNSTILE_SITE_KEY && <ContactForm sitekey={env.TURNSTILE_SITE_KEY} email={data[0].homePageFields.email} />}

<style>
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3rem;
		border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);
		padding: 5rem 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	h2 {
		font-size: var(--text-xl);
		text-align: center;
		max-width: 15ch;
	}

	@media (min-width: 50em) {
		aside {
			padding: 7.5rem;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
		}

		h2 {
			font-size: var(--text-3xl);
			text-align: left;
		}
	}
</style>
