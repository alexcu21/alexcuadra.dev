---
import Icon from './Icon.astro';
interface Props { href: string; text: string; }
const { href, text } = Astro.props;
---
<a href={href} target="_blank" rel="noopener noreferrer">
  {text}<span aria-hidden="true"><Icon icon="arrow-right" size="1.1em" /></span>
</a>
<style>
  a { display: inline-flex; align-items: center; justify-content: center; gap: .75rem; min-height: 2.75rem; padding: .75rem 1.25rem; border: 1px solid var(--gray-700); border-radius: 999rem; color: var(--link-color); background: var(--gray-900); text-decoration: none; font-size: .875rem; font-weight: 700; overflow-wrap: anywhere; }
  a:hover { border-color: var(--accent-regular); }
</style>
