---
interface Props {
  entries: { title: string; path: string; channels: { slug: string; name: string }[] }[];
  channels: { slug: string; name: string }[];
}
const { entries, channels } = Astro.props;
---
{entries.length > 0 && <section class="directory" aria-labelledby="reference-directory-title" data-reference-directory>
  <header><h2 id="reference-directory-title" tabindex="-1">Browse references</h2><p>Find a publication or mention by title and channel.</p></header>
  <form role="search" aria-label="Find references" class="filters" data-reference-controls hidden>
    <div><label for="reference-search">Search titles</label><input id="reference-search" type="search" maxlength="200" placeholder="Enter a title or keyword" autocomplete="off" aria-controls="reference-results" /></div>
    <div><label for="reference-channel">Channel</label><select id="reference-channel" aria-controls="reference-results"><option value="">All channels</option>{channels.map(channel => <option value={channel.slug}>{channel.name}</option>)}</select></div>
    <button type="button" data-reference-clear>Clear filters</button>
  </form>
  <p class="result-count" role="status" aria-live="polite" aria-atomic="true" data-reference-status>{entries.length} {entries.length === 1 ? 'reference' : 'references'}</p>
  <ul id="reference-results" class="entries">
    {entries.map(entry => <li data-reference-entry data-title={entry.title} data-channels={JSON.stringify(entry.channels.map(channel => channel.slug))}>
      <article><p class="channel-names">{entry.channels.map(channel => channel.name).join(' / ')}</p><h3><a href={entry.path}>{entry.title}<span aria-hidden="true"> ↗</span></a></h3></article>
    </li>)}
  </ul>
  <p class="empty" data-reference-empty hidden>No references match these filters. Try another title or clear the filters.</p>
</section>}
<script>
  import { mountReferenceFilter } from '../scripts/reference-filter.js';
  document.querySelectorAll('[data-reference-directory]').forEach(mountReferenceFilter);
</script>
<style>
  .directory { margin-top: 4rem; min-width: 0; }
  .directory h2 { font-size: clamp(1.6rem, 4vw, 2.5rem); letter-spacing: -.03em; }
  .directory h2:focus-visible { outline:2px solid var(--link-color); outline-offset:4px; }
  .directory header p { margin-top: .75rem; color: var(--gray-300); line-height: 1.6; }
  .filters { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; align-items: end; margin-block: 1.5rem; }
  .filters[hidden], [data-reference-entry][hidden], .empty[hidden] { display: none; }
  .filters > div { min-width: 0; }
  label { display: block; margin-bottom: .5rem; font-size: .875rem; font-weight: 600; }
  input, select, button { width: 100%; min-width: 0; min-height: 2.75rem; border: 1px solid var(--gray-800); border-radius: .6rem; background: var(--gray-999); color: var(--gray-0); padding: .75rem; font: inherit; }
  button { cursor: pointer; color: var(--link-color); }
  button:disabled { opacity: .5; cursor: default; }
  :is(input, select):focus-visible { outline: 2px solid var(--link-color); outline-offset: 3px; }
  .result-count { margin-block: 1rem; color: var(--gray-300); font: .8rem/1.5 var(--font-mono); }
  .entries { list-style: none; padding: 0; display: grid; gap: 1rem; }
  article { border: 1px solid var(--gray-800); border-radius: 1rem; padding: 1.5rem; background: var(--gradient-subtle); overflow-wrap: anywhere; }
  .channel-names { color: var(--link-color); font: .75rem/1.5 var(--font-mono); margin-bottom: .75rem; }
  h3 { font-size: 1.125rem; line-height: 1.6; }
  h3 a { color: var(--gray-0); text-decoration-thickness: 1px; text-underline-offset: .25em; }
  h3 a:hover { color: var(--link-color); }
  .empty { padding: 1.5rem; border: 1px dashed var(--gray-800); border-radius: 1rem; line-height: 1.7; }
  @media (min-width: 50em) { .filters { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) auto; } }
</style>
