---
import HomePage from '../components/HomePage.astro';
import { localizedPage } from '../data/localized-pages.js';
const publicTranslationLinks = (page: any) => page.translationLinks ?? [];
const page = await localizedPage('home', 'en');
if (!page) return new Response('Not found', { status: 404, headers: { 'Cache-Control': 'no-store', 'X-Robots-Tag': 'noindex' } });
const alternate = publicTranslationLinks(page).some((target: { locale: string }) => target.locale === 'es');
---
<HomePage page={page} locale="en" alternate={!!alternate} />
