---
import WordPressContent from '../../../../components/WordPressContent.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Icon from '../../../../components/Icon.astro';
import { referenceDetailPage, referenceNotFound } from '../../../../data/reference-pages.js';
import '../../../../styles/references.css';
import { referenceBreadcrumbs } from '../../../../data/reference-seo.js';
const { categorySlug, articleSlug } = Astro.params;
const page = await referenceDetailPage(categorySlug, articleSlug);
if (!page) return referenceNotFound();
const { article, category } = page;
const quote = article.articlesFields?.quote;
const image = article.featuredImage?.node?.sourceUrl;
---
<BaseLayout title={article.title} description={quote || article.title} image={image}>
  <script is:inline type="application/ld+json" set:html={referenceBreadcrumbs(category, article)} />
  <main id="main-content" tabindex="-1" class="wrapper references">
    <nav aria-label="Reference navigation"><a href={`/articles/category/${categorySlug}`}><Icon icon="arrow-left" /> {category.name}</a></nav>
    <header>
      <h1>{article.title}</h1>
      {quote && <blockquote><p>{quote}</p></blockquote>}
    </header>
    {image && <img class="reference-image" src={image} alt="" decoding="async" />}
    {article.content && <div class="reference-body"><WordPressContent html={article.content} /></div>}
  </main>
</BaseLayout>
