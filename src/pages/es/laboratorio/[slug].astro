---
import LabPage from '../../../components/LabPage.astro';
import { getLabProject } from '../../../data/lab-content.js';
const project = await getLabProject(Astro.params.slug, 'es');
if (!project) return new Response('Not found', { status: 404, headers: { 'Cache-Control': 'no-store', 'X-Robots-Tag': 'noindex' } });
---
<LabPage locale="es" project={project} />
