---
import ProjectPage from '../../../components/ProjectPage.astro';
import { getProjectsInfo } from '../../../data/client.js';
const { slug } = Astro.params;
const projects = await getProjectsInfo('es');
const project = projects.find((item: any) => item.slug === slug);
if (!project) return new Response('Not found', { status: 404, headers: { 'Cache-Control': 'no-store', 'X-Robots-Tag': 'noindex' } });
---
<ProjectPage project={project} projects={projects} locale="es" />
