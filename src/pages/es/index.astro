---
import HomePage from '../../components/HomePage.astro';
import { localizedPage } from '../../data/localized-pages.js';
const publicTranslationLinks = (page: any) => page.translationLinks ?? [];
const page = await localizedPage('home', 'es');
if (!page) return new Response('No encontrado', { status: 404, headers: { 'Cache-Control': 'no-store', 'X-Robots-Tag': 'noindex' } });
const alternate = publicTranslationLinks(page).some((target: { locale: string }) => target.locale === 'en');
---
<HomePage page={page} locale="es" alternate={!!alternate} />
