---
// Render the missing URL without WordPress; prerendering would lose its locale.
import { errorDocument } from '../data/error-document.js';
export const prerender = false;
Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex');
const locale = Astro.url.pathname === '/es' || Astro.url.pathname.startsWith('/es/') ? 'es' : 'en';
---
<Fragment set:html={errorDocument(404, locale)} />
