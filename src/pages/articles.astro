---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import CountBadge from '../components/CountBadge.astro';
import { getReferenceCategoryCards } from '../data/reference-categories.js';
import '../styles/references.css';
const categories = await getReferenceCategoryCards();
---
<BaseLayout title="Articles and Mentions | Alex Cuadra" description="External publications and mentions featuring Alex Cuadra.">
  <main id="main-content" tabindex="-1" class="wrapper references">
    <header><h1>Articles &amp; Mentions</h1><p class="intro">External publications and mentions.</p></header>
    <ul class="reference-grid">
      {categories.map((category: any) => <li class="reference-card"><a href={`/articles/category/${category.slug}`}><h2>{category.name}</h2><CountBadge count={category.count} /></a></li>)}
    </ul>
  </main>
  <ContactCTA />
</BaseLayout>
