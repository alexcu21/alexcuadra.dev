---
import AboutPage from '../components/AboutPage.astro';
import { localizedPage } from '../data/localized-pages.js';
const page = await localizedPage('about', 'en', 68);
if (!page) return new Response('Not found', { status: 404, headers: { 'X-Robots-Tag': 'noindex', 'Cache-Control': 'no-store' } });
const alternate = await localizedPage('about', 'es', 68);
---
<AboutPage aboutData={page} locale="en" alternate={!!alternate} />
